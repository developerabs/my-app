                    // এখানে ট্রাই-ক্যাচ ব্যবহার করছি যাতে এরর আসলে পুরো টেবিল ক্র্যাশ না করে
                    try {
                        var tableElement = $("#activity-log-table");
                        if ($.fn.DataTable.isDataTable(tableElement)) {
