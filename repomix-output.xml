            'updated_at' => now()
        ], $permissions);

        Permission::insertOrIgnore($permissionData);

        $roles = ['Super-Admin', 'Accounts', 'Editor', 'Reseller'];
        foreach ($roles as $roleName) {
            Role::firstOrCreate(['name' => $roleName, 'guard_name' => 'web']);
