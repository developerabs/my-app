    <script>
        $(document).ready(function() {
            // English comment: Global cache for units to avoid repeated API calls
            let cachedGroupUnits = [];

            // English comment: Initialize Form Submissions using helper function
            handleFormSubmit('#createUnitFormStop', '#createUnitModal', '#unit-table', false,
                resetUnitFormToDefault);
            handleFormSubmit('#editUnitForm', '#editUnitModal', '#unit-table', true);

            // English comment: Fetch units when Group changes (Works for both Create and Edit modals)
            $(document).on('change', 'select[name="group_id"]', function() {
                const groupId = $(this).val();
                const $modal = $(this).closest('.modal');

                if (!groupId) {
                    updateDropdowns([], $modal);
                    return;
                }

                const getUrl = "{{ route('units.getUnitsByGroup', ':groupId') }}".replace(':groupId',
                    groupId);

                $.get(getUrl, function(response) {
                    if (response.success) {
                        cachedGroupUnits = response.data;
                        updateDropdowns(cachedGroupUnits, $modal);
                    }
                });
            });

            // English comment: Helper function to update unit-related dropdowns within a specific modal
            function updateDropdowns(units, $context) {
                let options = '<option value="">Select Unit...</option>';
                units.forEach(unit => {
                    options += `<option value="${unit.id}">${unit.name} (${unit.short_name})</option>`;
                });
                $context.find('select[name="base_unit_id"], select[name="display_units[]"]').html(options);
            }

            // --- Create Modal Logic ---
            $('#isBaseUnit').on('change', function() {
                const isChecked = $(this).is(':checked');
                $('#baseUnitSelectContainer, #logicSection').toggle(!isChecked);
            }).trigger('change');

            $('#shortNameInput').on('input', function() {
                $('#currentUnitPreview').text($(this).val() || 'New Unit');
            });

            $('input[name="logic_type"]').on('change', function() {
                if ($(this).closest('#createUnitFormStop').length) {
                    const isFormula = (this.value === 'formula');
                    $('#formulaView').toggleClass('d-none', !isFormula);
                    $('#operatorView').toggleClass('d-none', isFormula);
                }
            });

            $('#formulaInput').on('input', function() {
                updateFormulaBadges($(this).val(), '#varBadges');
            });

            $('#addRow').on('click', function() {
                addHierarchyRow('#displayRowContainer');
            });

            // --- Edit Modal Logic (Using Delegation) ---
            $(document).on('change', '#edit_isBaseUnit', function() {
                const isChecked = $(this).is(':checked');
                $('#edit_baseUnitSelectContainer, #edit_logicSection').toggle(!isChecked);
            });

            $(document).on('change', '#editUnitForm input[name="logic_type"]', function() {
                const isFormula = (this.value === 'formula');
                $('#edit_formulaView').toggleClass('d-none', !isFormula);
                $('#edit_operatorView').toggleClass('d-none', isFormula);
            });

            $(document).on('input', '#edit_formulaInput', function() {
                updateFormulaBadges($(this).val(), '#edit_varBadges');
            });

            $(document).on('input', '#edit_short_name', function() {
                $('#edit_currentUnitPreview').text($(this).val() || 'Unit');
            });

            $('#edit_addRow').on('click', function() {
                addHierarchyRow('#edit_displayRowContainer');
            });

            // --- Common Helpers ---
            function updateFormulaBadges(val, containerSelector) {
                const vars = [...new Set(val.match(/[a-zA-Z_][a-zA-Z0-9_]*/g))]
                    .filter(v => !['x', 'round', 'ceil', 'floor', 'abs', 'sqrt'].includes(v.toLowerCase()));

                const badgeContainer = $(containerSelector);
                if (vars.length > 0) {
                    badgeContainer.html(vars.map(v => `<span class="badge bg-primary px-2 py-1">${v}</span>`).join(
                        ' '));
                } else {
                    badgeContainer.html('<em class="text-muted small">None detected yet</em>');
                }
            }

            function addHierarchyRow(containerSelector, selectedId = null) {
                let options = '<option value="">Select Higher Unit...</option>';
                cachedGroupUnits.forEach(unit => {
                    options +=
                        `<option value="${unit.id}" ${unit.id == selectedId ? 'selected' : ''}>${unit.name} (${unit.short_name})</option>`;
                });

                const html = `
                <div class="row g-2 mb-2 align-items-center animate__animated animate__fadeIn">
                    <div class="col-11">
                        <select name="display_units[]" class="form-select form-select-sm border-0 shadow-sm" required>${options}</select>
                    </div>
                    <div class="col-1 text-center">
                        <button type="button" class="btn btn-sm text-danger remove-row bg-transparent border-0"><i class="bi bi-trash3-fill"></i></button>
                    </div>
                </div>`;
                $(containerSelector).append(html);
            }

            $(document).on('click', '.remove-row', function() {
                $(this).closest('.row').remove();
            });

            // Global function for Edit Button Click
            window.editUnit = function(id) {
                const editUrl = "{{ route('units.edit', ':id') }}".replace(':id', id);
                const updateUrl = "{{ route('units.update', ':id') }}".replace(':id', id);

                $.get(editUrl, function(response) {
                    if (response.success) {
                        const unit = response.data;
                        const $form = $('#editUnitForm');

                        // Basic fields
                        $form.attr('action', updateUrl);
                        $('#edit_unit_id').val(unit.id);
                        $('#edit_name').val(unit.name);
                        $('#edit_short_name').val(unit.short_name);
                        $('#edit_precision').val(unit.precision);
                        $('#edit_currentUnitPreview').text(unit.short_name);

                        // English comment: Fetch units for the group
                        $('#edit_group_id').val(unit.group_id).trigger('change');

                        // --- Fixed Base Unit Logic ---
                        // English comment: Use Loose equality or Type conversion to handle string/integer '1'
                        const isBase = (unit.is_base_unit == 1 || unit.is_base_unit === true);

                        // English comment: Set checked property and manually trigger the display logic
                        $('#edit_isBaseUnit').prop('checked', isBase);

                        // English comment: Manually handle visibility because trigger('change') sometimes misses dynamic listeners
                        if (isBase) {
                            $('#edit_baseUnitSelectContainer, #edit_logicSection').hide();
                        } else {
                            $('#edit_baseUnitSelectContainer, #edit_logicSection').show();
                        }

                        // English comment: Delay to allow cachedGroupUnits to populate for dependent fields
                        setTimeout(() => {
                            if (!isBase) {
                                $('#edit_base_unit_id').val(unit.base_unit_id);

                                // Logic Type handling
                                if (unit.is_formulaic == 1) {
                                    $('#edit_logicFormula').prop('checked', true).trigger(
                                        'change');
                                    $('#edit_formulaInput').val(unit.formula).trigger('input');
                                } else {
                                    $('#edit_logicOp').prop('checked', true).trigger('change');
                                    $('#edit_operator').val(unit.operator);
                                    $('#edit_operator_value').val(unit.operator_value);
                                }
                            }

                            // Hierarchy rebuilding
                            $('#edit_displayRowContainer').empty();
                            if (response.hierarchy) {
                                response.hierarchy.forEach(hId => addHierarchyRow(
                                    '#edit_displayRowContainer', hId));
                            }
                        }, 600);

                        $('#editUnitModal').modal('show');
                    }
                });
            };
        });

        /**
         * Resets the Unit Configuration Modal to its default state.
         * English comment: Clears form, dynamic rows, and resets visibility.
         */
        function resetUnitFormToDefault() {
            const form = document.getElementById('createUnitFormStop');
            form.reset();
            document.getElementById('baseUnitSelectContainer').style.display = 'none';
            document.getElementById('logicSection').style.display = 'none';
            $('#formulaView').addClass('d-none');
            $('#operatorView').removeClass('d-none');
            $('#displayRowContainer').empty();
            $('#currentUnitPreview').text('New Unit');
            $('#varBadges').html('<em class="text-muted small">None detected yet</em>');
        }
    </script>
@endpush
