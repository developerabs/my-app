                                            <td colspan="2"></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>`);

                // Initialize Select2 for Combo Live Search
                $('#combo_search_select').select2({
                    placeholder: "Type product name, SKU or code...",
                    allowClear: true,
                    width: '100%',
                    ajax: {
                        url: "{{ route('products.searchForCombo') }}",
