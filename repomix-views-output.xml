        function changeMainImage(src, element) {
            $('#mainProdImage').attr('src', src);
            $('.img-thumbnail').removeClass('border-primary shadow-sm');
            $(element).addClass('border-primary shadow-sm');
        }

        /**
         * Global Handler Function to handle Full View switching
         * Place this logic inside your main scripts file or block scope.
         * 
         * @param {string|number} productId - Target element identifier
         * @param {boolean} shouldExpand - State driver toggle condition
         */
        function toggleProductFullView(productId, shouldExpand) {
            const container = document.getElementById(`product-container-${productId}`);
            if (!container) return;

            const metaWrapper = container.querySelector('.product-main-meta-wrapper');
            const fullViewHeader = container.querySelector('.full-view-header');
            const footerActionContainer = container.querySelector('.full-view-action-container');

            if (shouldExpand) {
                // Step 1: Append state hook flag to container 
                container.classList.add('is-full-view');
                
                // Step 2: Hide standard contextual details
                if (metaWrapper) metaWrapper.classList.add('d-none');
                if (footerActionContainer) footerActionContainer.classList.add('d-none');
                
                // Step 3: Show specialized table actions bar
                if (fullViewHeader) {
                    fullViewHeader.classList.remove('d-none');
                    fullViewHeader.classList.add('d-flex');
                }
            } else {
                // Reverse execution matrix flow back to absolute defaults
                container.classList.remove('is-full-view');
                
                if (metaWrapper) metaWrapper.classList.remove('d-none');
                if (footerActionContainer) footerActionContainer.classList.remove('d-none');
                
                if (fullViewHeader) {
                    fullViewHeader.classList.add('d-none');
                    fullViewHeader.classList.remove('d-flex');
                }
            }
        }

        function toggleViewBtnText(button, productId, targetClassName) {
            // Select the specific elements based on the passed class name
            const extraRows = document.querySelectorAll(`.${targetClassName}-${productId}`);
            const productMainContent = document.querySelector('.product-main-meta-wrapper');
            
            if (!productMainContent) return;

            // Initialize or get Bootstrap collapse instance for the product meta wrapper
            let bsMetaCollapse = bootstrap.Collapse.getInstance(productMainContent);
            if (!bsMetaCollapse) {
                bsMetaCollapse = new bootstrap.Collapse(productMainContent, { toggle: false });
            }

            // Save the original text count dynamically using dataset
            if (!button.dataset.remainingCount) {
                const match = button.innerText.match(/\((\d+)\s+More\)/i);
                button.dataset.remainingCount = match ? match[1] : '0';
            }
            const remainingCount = button.dataset.remainingCount;

            // Determine current state
            const isExpanding = button.getAttribute('aria-expanded') === 'false' || !button.hasAttribute('aria-expanded');

            if (isExpanding) {
                // 1. Smoothly show the target rows
                extraRows.forEach(row => {
                    let bsRow = bootstrap.Collapse.getInstance(row);
                    if (!bsRow) bsRow = new bootstrap.Collapse(row, { toggle: false });
                    bsRow.show();
                });

                // 2. Smoothly hide the main meta content
                bsMetaCollapse.hide();

                // 3. Update button
                button.setAttribute('aria-expanded', 'true');
                button.innerHTML = 'Show Less ▴';
            } else {
                // 1. Smoothly hide the target rows
                extraRows.forEach(row => {
                    let bsRow = bootstrap.Collapse.getInstance(row);
                    if (bsRow) bsRow.hide();
                });

                // 2. Smoothly show the main meta content
                bsMetaCollapse.show();

                // 3. Update button
                button.setAttribute('aria-expanded', 'false');
                button.innerHTML = `View Full (${remainingCount} More) ▾`;
            }
        }
    </script>
